# Postgres
POSTGRES_DB=turbofan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# App
APP_TAG=local
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/turbofan
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change-me-in-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=admin@turbofan.local
BOOTSTRAP_ADMIN_PASSWORD=admin123!
BOOTSTRAP_ADMIN_ROLE=admin

# Dashboard
VITE_API_BASE_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000
DASHBOARD_PORT=3000

# MQTT / simulator
MQTT_BROKER=mqtt-broker
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_TOPIC=turbofan/telemetry
SIM_ENGINES=4
SIM_INTERVAL=0.5
SIM_BATCH_MODE=false
SIM_DEBUG=false
