
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/turbofan-telemetry.json",
  "title": "Turbofan Telemetry Frame",
  "description": "CMAPSS-like turbofan engine telemetry payload for MQTT publishing.",
  "type": "object",
  "required": ["timestamp", "engine_id", "sequence", "operating_condition", "sensors", "quality", "meta"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "engine_id": { "type": "string", "pattern": "^E_\\d{3}$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "operating_condition": {
      "type": "object",
      "required": ["alt", "Mach", "Throttle"],
      "properties": {
        "alt": { "type": "number" },
        "Mach": { "type": "number" },
        "Throttle": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "sensors": {
      "type": "object",
      "required": ["EGT", "T2", "P30", "Nf", "Nc", "Ps30", "Wf", "phi", "NRc"],
      "properties": {
        "EGT": { "type": "number" },
        "T2": { "type": "number" },
        "P30": { "type": "number" },
        "Nf": { "type": "number" },
        "Nc": { "type": "number" },
        "Ps30": { "type": "number" },
        "Wf": { "type": "number", "minimum": 0, "maximum": 1 },
        "phi": { "type": "number", "minimum": 0, "maximum": 1 },
        "NRc": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["status", "missing"],
      "properties": {
        "status": { "type": "string", "enum": ["OK", "WARN", "BAD"] },
        "missing": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["source", "schema_version"],
      "properties": {
        "source": { "type": "string" },
        "schema_version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
